pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        VENV = '.venv'
        DEPLOY_DIR = 'python-app-deploy'
    }

    stages {
        stage('Build') {
            steps {
                echo 'Installing Python dependencies...'
                sh '''
                    python3 --version
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/pip" install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    "$VENV/bin/python" -m unittest discover \
                        -s . -p 'test_*.py' -v
                '''
            }
        }

        stage('Code Quality') {
            steps {
                echo 'Checking Python code quality...'
                sh '''
                    "$VENV/bin/flake8" app.py test_app.py \
                        --max-line-length=100
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Preparing deployment directory...'
                sh '''
                    mkdir -p "$WORKSPACE/$DEPLOY_DIR"
                    cp app.py requirements.txt Dockerfile \
                        "$WORKSPACE/$DEPLOY_DIR/"
                '''
            }
        }

        stage('Test Deployed Application') {
            steps {
                echo 'Verifying the deployed application...'
                sh '''
                    cd "$WORKSPACE/$DEPLOY_DIR"

                    nohup "$WORKSPACE/$VENV/bin/python" app.py \
                        > app.log 2>&1 &
                    echo $! > app.pid

                    "$WORKSPACE/$VENV/bin/python" - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"
last_error = None

for attempt in range(20):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode("utf-8")
            assert response.status == 200, response.status
            assert body == "Hello, Jenkins Multi-Stage Pipeline!", body
            print("Deployed application HTTP check passed.")
            print(body)
            break
    except Exception as error:
        last_error = error
        time.sleep(1)
else:
    raise RuntimeError(
        "Deployed application did not respond successfully"
    ) from last_error
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Build, tests, quality checks and deployment verification passed.'
        }
        failure {
            echo 'FAILURE: Check the stage logs in Console Output.'
        }
        always {
            sh '''
                if [ -f "$WORKSPACE/$DEPLOY_DIR/app.pid" ]; then
                    kill "$(cat "$WORKSPACE/$DEPLOY_DIR/app.pid")" \
                        2>/dev/null || true
                fi
            '''
            echo 'Exercise 9 pipeline finished.'
        }
    }
}
